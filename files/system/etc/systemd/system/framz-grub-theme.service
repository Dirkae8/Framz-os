[Unit]
Description=FRAMZ OS — тема загрузчика GRUB
Documentation=man:grub2-mkconfig(8)
# Тема нужна к следующей загрузке, поэтому запускаемся после монтирования /boot
After=local-fs.target
ConditionPathExists=/boot/grub2
ConditionPathExists=!/var/lib/framz/grub-themed

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/framz-grub-theme
# Ничего не должно ломать загрузку системы: ошибка юнита не критична
SuccessExitStatus=0 1
Nice=10

[Install]
WantedBy=multi-user.target
