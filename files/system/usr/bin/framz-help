#!/usr/bin/env bash
# FRAMZ OS — справка «что где лежит».
#
# Простое окно, которое отвечает на вопросы новичка: где мои программы, как
# обновляться, что делать если сломалось, где настройки. Без интернета.
set -uo pipefail

TITLE="Справка FRAMZ OS"

if ! command -v kdialog >/dev/null 2>&1; then
  cat <<'EOF'
FRAMZ OS — что где лежит

  Программы        — меню «Пуск» (наш лаунчер) или Discover
  Настройки        — «Параметры системы» (значок шестерёнки)
  Обновления       — framz update  ·  откат: framz rollback
  Профили нагрузки — framz tune game | dev | studio  ·  статус: framz status
  Мастерская       — Distrobox (контейнеры для инструментов)
  Терминал         — Konsole, профиль FRAMZ уже настроен
EOF
  exit 0
fi

MENU_TEXT="Что тебе подсказать?"

CHOICE="$(kdialog --title "${TITLE}" --menu "${MENU_TEXT}" \
  apps "Где программы и магазин" \
  devel "Профили под игры и разработку" \
  updates "Обновления и откат системы" \
  settings "Настройки, темы, обои" \
  media "Звук, планшеты, цвет (творчество)" \
  broken "Что-то не работает" 2>/dev/null)" || exit 0

case "${CHOICE}" in
  apps)
    kdialog --title "${TITLE}" --msgbox "Все программы — в нашем меню:
нажми знак FRAMZ в левом нижнем углу панели. Там разделы:
  · Творчество — Krita, Blender, Kdenlive, OBS, Ardour, darktable
  · Медиа — плееры и просмотрщики
  · Система — терминал, настройки, файлы

Что-то ещё есть в магазине Discover (Flatpak, Flathub)."
    ;;
  devel)
    kdialog --title "${TITLE}" --msgbox "Одной командой система настраивается под задачу:

  sudo framz-tune game     — игры: планировщик, приоритеты, звук
  sudo framz-tune dev      — разработка: отзывчивость, кэши, лимиты
  sudo framz-tune studio   — творчество: малая задержка звука
  sudo framz-tune balanced — вернуть обычный режим

Что включено сейчас:  framz status

Выключить профиль:    sudo framz-tune balanced"
    ;;
  updates)
    kdialog --title "${TITLE}" --msgbox "Обновление — система обновляется целиком:

  framz update      — окно с кнопками (скачать, перезагрузить)
  framz rollback    — вернуть прошлое состояние, если стало хуже
  framz status      — посмотреть, что установлено и какой профиль

После обновления нужна перезагрузка — иначе изменения не вступят в силу."
    ;;
  settings)
    kdialog --title "${TITLE}" --msgbox "Темы и оформление:
  Параметры системы → Оформление.
Наши темы: Frame Dark (тёмная) и Studio Light (светлая).

Обои: правый клик по рабочему столу → «Настроить рабочий стол».
Наш знак и цвета уже применены в системе — трогать ничего не нужно."
    ;;
  media)
    kdialog --title "${TITLE}" --msgbox "Звук:
  Звук без задержек уже настроен (PipeWire + JACK).
  Для творческого профиля: sudo framz-tune studio

Графические планшеты: поддержка уже в системе,
  калибровка — в Параметрах системы → Планшет.

Цвет и калибровка монитора:
  colord + argyllcms уже установлены,
  профили — Параметры системы → Цвет."
    ;;
  broken)
    kdialog --title "${TITLE}" --msgbox "Если что-то сломалось после обновления:

  1. Открой терминал и напиши:  framz rollback
  2. Перезагрузись:             systemctl reboot
  3. Система вернётся в прошлое состояние — файлы не потеряются.

Если не работает вход или чёрный экран:
  загрузись в «FRAMZ OS (запасной)» в меню загрузчика.
Если совсем ничего: напиши в обсуждениях проекта на GitHub —
  у нас есть раздел с частыми проблемами."
    ;;
esac
