    versionedName:       "FRAMZ OS 1.0"
    shortVersionedName:  "FRAMZ 1.0"
    bootloaderEntryName: "FRAMZ OS"
    productUrl:          "https://github.com/Dirkae8/Framz-os"
    supportUrl:          "https://github.com/Dirkae8/Framz-os/issues"
    releaseNotesUrl:     "https://github.com/Dirkae8/Framz-os/releases"

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

style:
    sidebarBackground:       "#FFFFFF"
    sidebarText:             "#0B0B12"
    sidebarTextSelect:       "#0B0B12"
    sidebarBackgroundSelect: "#E4E4EA"

slideshow: "show.qml"
