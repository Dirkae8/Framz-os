# FRAMZ OS — как выглядит установщик: название, знак, цвета.
# Стиль «Minimal Mono»: белый фон, чёрный акцент (тот же, что в Fedora-редакции).
---
componentName: framz

strings:
    productName:         "FRAMZ OS"
    shortProductName:    "FRAMZ"
    version:             "1.0"
