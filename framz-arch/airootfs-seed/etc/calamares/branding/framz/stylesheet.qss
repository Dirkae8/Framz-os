/* FRAMZ OS — оформление установщика: белый фон, чёрный акцент, ничего лишнего. */
QMainWindow, QWidget, QDialog {
    background: #FFFFFF;
    color: #0B0B12;
}
QPushButton {
    background: #0B0B12;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
}
QPushButton:hover   { background: #3A3A46; }
QPushButton:disabled { background: #C9C9D2; color: #6A6A76; }
QPushButton#quitButton, QPushButton#cancelButton {
    background: transparent;
    color: #0B0B12;
    border: 1px solid #C9C9D2;
}
QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #FFFFFF;
    color: #0B0B12;
    border: 1px solid #C9C9D2;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #0B0B12;
    selection-color: #FFFFFF;
}
QProgressBar {
    background: #F1F1F5;
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: #0B0B12;
}
QProgressBar::chunk { background: #0B0B12; border-radius: 6px; }
QLabel#title   { font-size: 20px; font-weight: 600; color: #0B0B12; }
QLabel          { color: #0B0B12; }
QScrollArea     { border: none; }
