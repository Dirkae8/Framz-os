# FRAMZ OS — пакеты Arch-издания.
# Правило: лёгкая система; тяжёлые творческие приложения — из Flatpak, а не в ISO.
# Сборка сама отфильтрует пакеты, которых нет в репозиториях (см. .github/workflows/build-arch.yml).

# --- база ---
base
linux-zen
linux-zen-headers
linux-firmware
mkinitcpio
sudo
nano
vim
git
curl
wget
rsync
unzip
bash-completion

# --- загрузка и вход ---
syslinux
grub
efibootmgr
os-prober
dosfstools
mtools
plymouth
sddm
sddm-kcm

# --- звук, видео, графика ---
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
mesa
vulkan-radeon
vulkan-intel
sof-firmware
noto-fonts
noto-fonts-cjk
ttf-jetbrains-mono-nerd

# --- сеть ---
networkmanager
network-manager-applet
bluez
bluez-utils
firewalld

# --- рабочий стол KDE Plasma ---
plasma-meta
kde-gtk-config
breeze-gtk
kde-cli-tools
dolphin
ark
konsole
spectacle
gwenview
kdeconnect
flatpak
plasma-nm

# --- наши инструменты и творческая настройка ---
libwacom
colord
argyllcms
distrobox
podman
btop
gamemode
zram-generator
irqbalance
cpupower
powertop
hdparm
ethtool

# --- файловая система и откат ---
btrfs-progs
snapper
snap-pac

# --- установщик (наш, свой) и живой режим ---
mkinitcpio-archiso
squashfs-tools
kde-cli-tools
discover
parted
gptfdisk
rsync
arch-install-scripts
